{
  "name": "mdzip-obsidian",
  "version": "0.1.0",
  "description": "Obsidian plugin for reading and writing .mdz (MDZip) single-document archives.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "keywords": [
    "obsidian",
    "mdz",
    "mdzip",
    "markdown"
  ],
  "author": "mdzip-project",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@mdzip/core-js": "file:../mdzip-core-js",
    "fflate": "^0.8.3"
  }
}
